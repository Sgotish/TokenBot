[Unit]
Description=Refresh sanitized TokenBot partner usage
After=docker.service
[Service]
Type=oneshot
User=root
WorkingDirectory=/opt/tokenbot-pilot
ExecStart=/opt/tokenbot-pilot/venv/bin/python scripts/collect_partner_usage.py /opt/tokenbot-pilot/private/collector.json
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/tokenbot-status
TimeoutStartSec=100
MemoryMax=96M
