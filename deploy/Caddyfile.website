# Add to the existing Caddyfile; do not replace the pilot API site's routes.
# DNS: @ A 159.203.4.206; www CNAME tokenbots.top (TTL 600).
# Website is an always-on loopback service; no Render cold-start dependency.
# Caddy overwrites untrusted forwarded headers. No private response caching.
tokenbots.top {
    bind 159.203.4.206
    reverse_proxy 127.0.0.1:8186 {
        transport http {
            dial_timeout 5s
            response_header_timeout 90s
        }
    }
}
www.tokenbots.top {
    bind 159.203.4.206
    redir https://tokenbots.top{uri} permanent
}
