& {
$ErrorActionPreference = 'Stop'
$tbUrl = '__BASE_URL__'
$tbKey = '__TEST_KEY__'
[Net.ServicePointManager]::SecurityProtocol = [Net.SecurityProtocolType]::Tls12
$tbCheck = Invoke-RestMethod -Uri ($tbUrl + '/models') -Headers @{Authorization=('Bearer ' + $tbKey)} -TimeoutSec 30
if (-not ($tbCheck.data.id -contains 'gpt-6.1-sol')) { throw 'Test model is unavailable. Nothing was changed.' }
$tbDir = if ($env:CODEX_HOME) { $env:CODEX_HOME } else { Join-Path $env:USERPROFILE '.codex' }
New-Item -ItemType Directory -Path $tbDir -Force | Out-Null
$tbPath = Join-Path $tbDir 'config.toml'
$tbOld = if (Test-Path $tbPath) { [IO.File]::ReadAllText($tbPath) } else { '' }
if ($tbOld.Contains('tokenbots_partner_20261016')) { throw 'This test provider is already configured. Do not run twice.' }
if ($tbOld.Contains('"""') -or $tbOld.Contains("'''")) { throw 'Multiline TOML found. Ask us to merge manually; nothing was changed.' }
if ($tbOld -match '(?m)^\s*model_providers\s*=') { throw 'Inline provider configuration found. Ask us to merge manually.' }
$tbBackup = $tbPath + '.before-tokenbots-' + (Get-Date -Format 'yyyyMMdd-HHmmss')
if (Test-Path $tbPath) { Copy-Item -LiteralPath $tbPath -Destination $tbBackup }
$tbSection = [regex]::Match($tbOld, '(?m)^[ \t]*\[')
$tbRoot = if ($tbSection.Success) { $tbOld.Substring(0,$tbSection.Index) } else { $tbOld }
$tbRest = if ($tbSection.Success) { $tbOld.Substring($tbSection.Index) } else { '' }
$tbRoot = [regex]::Replace($tbRoot, '(?m)^[ \t]*(model|model_provider|model_reasoning_effort|service_tier)[ \t]*=[^\r\n]*(\r?\n|$)', '')
$tbNew = @"
model = "gpt-6.1-sol"
model_provider = "tokenbots_partner_20261016"
model_reasoning_effort = "medium"
$tbRoot
$tbRest

[model_providers.tokenbots_partner_20261016]
name = "TokenBots Partner Test"
base_url = "$tbUrl"
wire_api = "responses"
experimental_bearer_token = "$tbKey"
requires_openai_auth = false
supports_websockets = false
request_max_retries = 0
stream_max_retries = 0
stream_idle_timeout_ms = 300000

[model_providers.tokenbots_partner_20261016.capabilities]
remote_compaction = "unsupported"
"@
[IO.File]::WriteAllText($tbPath, $tbNew, (New-Object Text.UTF8Encoding($false)))
Remove-Variable tbKey,tbNew
Write-Host 'Configured. Fully exit Codex, reopen it, and start a NEW LOCAL chat.'
Write-Host ('Original configuration backup: ' + $tbBackup)
}
