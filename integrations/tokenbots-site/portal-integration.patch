+'use strict';
+let csrf='', pending=false;
+const buttons=[...document.querySelectorAll('button[data-target]')];
+async function call(path,body){const r=await fetch(path,{method:body?'POST':'GET',headers:body?{'Content-Type':'application/json','X-CSRF-Token':csrf}:{},body:body?JSON.stringify(body):undefined,credentials:'same-origin',cache:'no-store'});const j=await r.json();if(!r.ok)throw Error(j.error||'请求失败');return j;}
+async function refresh(){try{const s=await call('/api/pilot/status');document.getElementById('connection').textContent=s.connected?'本机测试程序已连接':'本机测试程序未连接';const busy=s.jobs.some(j=>['queued','running'].includes(j.status));buttons.forEach(b=>b.disabled=pending||busy||!s.connected);const list=document.getElementById('results');list.replaceChildren();for(const j of [...s.jobs].reverse()){const a=document.createElement('article'),h=document.createElement('strong'),p=document.createElement('pre');h.textContent=`${j.target==='pro'?'Pro 100':'Plus'} · ${{queued:'等待本机领取',running:'正在调用',completed:'完成',failed:'失败',unknown:'结果未知'}[j.status]||j.status}`;p.textContent=j.output||'等待结果…';a.append(h,p);list.append(a);}}catch(e){document.getElementById('connection').textContent=e.message;buttons.forEach(b=>b.disabled=true);}}
+buttons.forEach(b=>b.addEventListener('click',async()=>{pending=true;buttons.forEach(x=>x.disabled=true);document.getElementById('notice').textContent='';try{await call('/api/pilot/run',{target:b.dataset.target});}catch(e){document.getElementById('notice').textContent=e.message;}finally{pending=false;await refresh();}}));
+(async()=>{try{csrf=(await call('/api/portal/me')).csrf;await refresh();setInterval(refresh,3000);}catch(e){document.getElementById('connection').textContent='请先在控制台登录管理员账号。';}})();
